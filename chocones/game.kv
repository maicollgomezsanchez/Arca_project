#:import utils kivy.utils
#:import Factory kivy.factory.Factory

############ CONSTANTES #########
#:set radius_default 25
#:set color_timer '#ffffff'
#:set color_timer_press '#aeaeae'
#:set color_stop '#db1a1a'
#:set color_stop_pressed '#7c0101'
#:set color_start '#26c626'
#:set color_start_presed '#033203'
#:set color_pause '#ffff00'
#:set color_pause_pressed '#4b4b00'
#:set c_modos '#2929ff'
#:set c_modos_p '#005d00'
#:set c_label '#ffffff'
#:set c_btn '#ffffff'
#:set c_btn_p '#646464'
#:set c_dis '#834a4a00'
#:set color_popup '#887700'
#:set label_txt_viaje 'TIEMPO VIAJE'
#:set label_txt_parada 'TIEMPO ESPERA'
#:set title_popup '¡ALERTA!\nBOTON EMERGENCIA PRESIONADO'
#:set label_start 'MARCHA'
#:set label_pause 'PAUSA'
#:set label_stop 'PARO'
#:set c_text '#000000'
#:set c_text_dis '#b7b7b7'

<Popup_banner>:
    auto_dismiss: False
    size_hint: 0.6, 0.2
    title: ''
    separator_height: 0
    background_color: utils.get_color_from_hex(color_popup)

    BoxLayout:
        orientation: "vertical"
        size: root.width, root.height

        canvas.before:
            Color:
                rgba: utils.get_color_from_hex(color_popup)
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            id: label_popup
            color: utils.get_color_from_hex('#000000')
            text: title_popup
            halign: 'center'
            valign: 'middle'


# Estilo para los layouts
<BoxLayout>:
    spacing: 5
    padding: 5, 5

<Label>:
    bold: True

<Button>:
    padding: 5, 5
    font_size: 35
    color:  utils.get_color_from_hex(c_text if self.state == 'normal' else c_text_dis)
    background_color: (0, 0, 0, 0)
    halign: 'center'
    valign: 'middle'
    bold: True

# -------------------------
# ESTILOS REUTILIZABLES
# -------------------------

<LabelWithBg@Label>:
    size_hint_y: None
    height: self.texture_size[1] + 20
    text_size: None, None
    padding: 10, 10
    color: utils.get_color_from_hex(c_text)
    font_size: 35
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(c_label)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15]


<WhiteLabel@Label>:
    font_size: 90
    font_name: "fonts/DSEG7Classic-Bold.ttf"
    color: utils.get_color_from_hex('#ff0000')
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(c_label)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15]

<RoundButton@Button>:
    size_hint: None, None
    size: self.height, self.height
    font_size: 80
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(color_timer_press if self.disabled else color_timer)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [radius_default]
    on_press:
        self.canvas.before.children[0].rgba = utils.get_color_from_hex(color_timer_press)
    on_release:
        self.canvas.before.children[0].rgba = utils.get_color_from_hex(color_timer)



#################### VISTA PRINCIPAL ##############
<viewMain>:
    canvas.before:
        Rectangle:
            pos: self.pos
            size: self.size
            source: "fondo.jpeg"

    BoxLayout:
        orientation: 'vertical'
        size: root.width, root.height

        # Primera fila
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.2
            BoxLayout:
                ToggleButton:
                    id: manual_button
                    text: "MANUAL"
                    group: "mode"
                    on_press: root.mode_press(self.text)
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex(c_modos_p if self.state == 'down' else c_modos)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [radius_default]
            BoxLayout:
                ToggleButton:
                    id: semi_button
                    text: "SEMI"
                    group: "mode"
                    on_press: root.mode_press(self.text)
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex(c_modos_p if self.state == 'down' else c_modos)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [radius_default]
            BoxLayout:
                ToggleButton:
                    id: auto_button
                    text: "AUTO"
                    group: "mode"
                    on_press: root.mode_press(self.text)
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex(c_modos_p if self.state == 'down' else c_modos)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [radius_default]
            BoxLayout:
                Button:
                    id: luces_button
                    text: "ILUM"
                    #group: "mode"
                    on_press: root.open_pop_up_luces()
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex(c_modos_p if self.state == 'down' else c_modos)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [radius_default]

        # Segunda fila
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.6
            spacing: 10
            # -------------------------
            # COLUMNA TIEMPO VIAJE
            # -------------------------
            BoxLayout:
                orientation: 'vertical'
                spacing: 5

                LabelWithBg:
                    size_hint_y: 0.2
                    text: label_txt_viaje

                WhiteLabel:
                    size_hint_y: 0.4
                    text: str(root.label_time_travel)

                BoxLayout:
                    size_hint_y: 0.4
                    BoxLayout:
                        size_hint_x: None
                        width: self.minimum_width
                        padding: 5,10
                        spacing: 90

                        RoundButton:
                            id: btn_travel_p
                            text: "+"
                            on_press: root.on_button_press('travel_+')
                            on_release: root.on_button_release()

                        RoundButton:
                            id: btn_travel_m
                            text: "--"
                            on_press: root.on_button_press('travel_-')
                            on_release: root.on_button_release()

            # -------------------------
            # COLUMNA TIEMPO PARADA
            # -------------------------
            BoxLayout:
                orientation: 'vertical'
                spacing: 5

                LabelWithBg:
                    size_hint_y: 0.2
                    text: label_txt_parada

                WhiteLabel:
                    size_hint_y: 0.4
                    text: str(root.label_time_wait)

                BoxLayout:
                    size_hint_y: 0.4

                    BoxLayout:
                        size_hint_x: None
                        width: self.minimum_width
                        padding: 5,10
                        spacing:  90

                        RoundButton:
                            id: btn_wait_p
                            text: "+"
                            on_press: root.on_button_press('auto_+')
                            on_release:
                                root.on_button_release()

                        RoundButton:
                            id: btn_wait_m
                            text: "--"
                            on_press: root.on_button_press('auto_-')
                            on_release:
                                root.on_button_release()

            # Columna botones especiales
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 1
                spacing: 30
                # Boton activar comer ficha
                ToggleButton:
                    id: decoin_button
                    text: "DESACTIVAR\nDESCARGA" if self.state == 'normal' else "ACTIVAR\nDESCARGA"
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex(c_btn if self.state == 'normal' else c_btn_p)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [radius_default]
                    on_press:
                        root.decoin_press()
                # Boton comer ficha
                Button:
                    id: coin_button
                    text:  '' if self.disabled else 'COMER\nFICHAS'
                    canvas.before:
                        Color:
                            rgba:
                                utils.get_color_from_hex(c_dis if self.disabled else c_btn)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [30]
                    on_press:
                        self.canvas.before.children[0].rgba = utils.get_color_from_hex(c_btn_p)
                        root.eating_coin()
                    on_release:
                        self.canvas.before.children[0].rgba = utils.get_color_from_hex(c_btn)
                # Boton bocina
                Button:
                    text: "BOCINA"
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex(c_btn)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [30]
                    on_press:
                        self.canvas.before.children[0].rgba = utils.get_color_from_hex(c_btn_p)
                        root.set_bocina(True)
                    on_release:
                        self.canvas.before.children[0].rgba = utils.get_color_from_hex(c_btn)
                        root.set_bocina(False)
                #Button:
                #    text: "MUSICA"
                #    canvas.before:
                #        Color:
                #            rgba: utils.get_color_from_hex(c_btn)
                #        RoundedRectangle:
                #            size: self.size
                #            pos: self.pos
                #            radius: [30]
                #    on_press:
                #        self.canvas.before.children[0].rgba = utils.get_color_from_hex(c_btn_p)
                #    on_release:
                #        self.canvas.before.children[0].rgba = utils.get_color_from_hex(c_btn)
        # Tercera fila
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.2
            ToggleButton:
                id: start_button
                text: label_start
                group: 'state'
                color:  utils.get_color_from_hex(c_text if self.state == 'normal' else c_text)
                disabled_color: utils.get_color_from_hex('#ffffff')
                on_press:
                    root.state_press('START')
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex(color_start_presed if self.disabled else  color_start)
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [30]
            # Boton pause
            ToggleButton:
                id: pause_button
                text: label_pause
                group: 'state'
                color:  utils.get_color_from_hex(c_text if self.state == 'normal' else c_text)
                disabled_color: utils.get_color_from_hex('#ffffff')
                on_press:
                    root.state_press('PAUSE')
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex(color_pause_pressed if self.disabled else color_pause)
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [30]
            # Boton stop
            Button:
                id: stop_button
                text: label_stop
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex(color_stop)
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [30]
                on_press:
                    root.state_press('STOP')
                    self.canvas.before.children[0].rgba = utils.get_color_from_hex(color_stop_pressed)
                on_release:
                    self.canvas.before.children[0].rgba = utils.get_color_from_hex(color_stop)

<ToggleButtonLed@ToggleButton>:
    text: ''
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex('#025e02' if self.state == 'down' else '#fbff00')
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [30]

<Popup_luces>:
    auto_dismiss: False
    separator_height: 0
    size_hint: 1, 1
    title: ''
    background_color: utils.get_color_from_hex (c_modos)

    GridLayout:
        cols: 3
        rows: 4
        spacing: 15
        padding: 20

        ToggleButtonLed:
            id: luz1
            text: 'SALIDA 1\nENCENDIDA' if self.state == 'down' else 'SALIDA 1\nAPAGADA'
            on_state:
                root.luces_pressed_state(1, self.state)

        ToggleButtonLed:
            id: luz2
            text: 'SALIDA 2\nENCENDIDA' if self.state == 'down' else 'SALIDA 2\nAPAGADA'
            on_state:
                root.luces_pressed_state(2, self.state)

        Button:
            text: 'Volver'
            on_release: root.dismiss()
            canvas.before:
                Color:
                    rgba: utils.get_color_from_hex('#888888' if self.state == 'down' else '#ffffff')
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [30]

        ToggleButtonLed:
            id: luz3
            text: 'SALIDA 3\nENCENDIDA' if self.state == 'down' else 'SALIDA 3\nAPAGADA'
            on_state:
                root.luces_pressed_state(3, self.state)

        ToggleButtonLed:
            id: luz4
            text: 'SALIDA 4\nENCENDIDA' if self.state == 'down' else 'SALIDA 4\nAPAGADA'
            on_state:
                root.luces_pressed_state(4, self.state)

        Widget:

        ToggleButtonLed:
            id: luz5
            text: 'SALIDA 5\nENCENDIDA' if self.state == 'down' else 'SALIDA 5\nAPAGADA'
            on_state:
                root.luces_pressed_state(5, self.state)

        ToggleButtonLed:
            id: luz6
            text: 'SALIDA 6\nENCENDIDA' if self.state == 'down' else 'SALIDA 6\nAPAGADA'
            on_state:
                root.luces_pressed_state(6, self.state)

        Widget:

        ToggleButtonLed:
            id: luz7
            text: 'SALIDA 7\nENCENDIDA' if self.state == 'down' else 'SALIDA 7\nAPAGADA'
            on_state:
                root.luces_pressed_state(7, self.state)

        ToggleButtonLed:
            id: luz8
            text: 'SALIDA 8\nENCENDIDA' if self.state == 'down' else 'SALIDA 8\nAPAGADA'
            on_state:
                root.luces_pressed_state(8, self.state)

        Button:
            text: 'APAGAR\nTODO'
            on_release: root.luces_all_off()
            canvas.before:
                Color:
                    rgba: utils.get_color_from_hex('#025e02' if self.state == 'down' else '#fbff00')
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [30]
